# --- Database (prefer DATABASE_URL for Neon / Render / Azure App Service) ---
# Example Neon: postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Local / docker-compose fallback when DATABASE_URL is empty
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fashion_shop

# TypeORM schema sync (true for local/dev; keep true until migrations are adopted)
TYPEORM_SYNCHRONIZE=true

# --- Redis (OPTIONAL) ---
# Local docker-compose: redis://localhost:6379
# Azure App Service F1: leave unset — API degrades gracefully without cache
REDIS_URL=
# Cache TTL in seconds for list endpoints (default 60)
CACHE_TTL_SECONDS=60

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FE_URL=http://localhost:5173

# --- JWT ---
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# --- Mail ---
MAIL_USER=your_email@example.com
MAIL_PASS=your_app_password

# --- Cloudinary (CDN / images — free tier OK) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# --- Admin seed endpoint POST /auth/seed-admin ---
ADMIN_SEED_SECRET=dev-seed-secret

# --- VNPay ---
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_RETURN_URL=http://localhost:3000/orders/vnpay-return

# --- Gemini (AI chat) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
